{
  "name": "retirement-calculator",
  "version": "3.0.0",
  "description": "A versatile retirement financial planning tool for calculating savings, inflation impact, and withdrawal strategies.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build-docs": "typedoc --tsconfig tsconfig.docs.json --sort source-order",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run format && npm run lint && npm run test && npm run build",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/introvertedspud/retirement-calculator.git"
  },
  "keywords": [
    "retirement",
    "calculator",
    "financial",
    "planning",
    "savings",
    "investment",
    "compound-interest",
    "finance",
    "typescript",
    "money",
    "pension",
    "retirement-savings",
    "financial-tool",
    "personal-finance",
    "wealth-management",
    "retirement-planning",
    "investment-calculator"
  ],
  "author": "Shaun Bonk",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/introvertedspud/retirement-calculator/issues"
  },
  "homepage": "https://github.com/introvertedspud/retirement-calculator#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typedoc": "^0.25.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
